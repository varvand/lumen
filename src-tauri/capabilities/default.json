{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local Lumen window capabilities",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-destroy", "dialog:allow-save", "opener:default", { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPDATA/**" }, { "path": "$LOCALDATA/**" }, { "path": "$HOME/Library/Application Support/app.lumen.desktop/**" }] }]
}
